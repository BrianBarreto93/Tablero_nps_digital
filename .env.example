# Copiar a .env (no versionado) y completar. Mismos nombres que CSAT Hogar / claro_CR_Recurrencia.
# Oracle: lectura de INVITADO_15.TBL_DIGITAL_* (APP_WEB, WHATSAPP_BOT, ECOMMERCE, TOUCHPOINT)
# (las mismas del .env de D:\Proyectos\4. Estudios Digital, que las carga desde Qualtrics;
#  allá ORACLE_SERVICE_NAME aquí se llama ORACLE_DBNAME)
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DBNAME=

# SFTP LAN: publicación del tablero (las del .env de 2. SOP_FM o 3. FACT_PAG_COBRO)
SFTP_HOST_LAN=
SFTP_PORT_LAN=
SFTP_USER_LAN=
SFTP_PASS_LAN=
